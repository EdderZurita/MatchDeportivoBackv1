# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
# Vacio = SQLite local. En Render/Supabase: postgresql://...
DATABASE_URL=

# Correo OTP (Brevo)
BREVO_API_KEY=
EMAIL_HOST_USER=

# Pagos Flow (sandbox)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_PLAN_ID=premium_mensual
BASE_URL_BACKEND=http://127.0.0.1:8000

# Sincronizar Premium con Flow (quita Premium a quien deja de pagar). Dejar en False
# hasta probar con el sandbox de Flow.
PREMIUM_SYNC_ENABLED=False
PREMIUM_SYNC_INTERVALO_SEG=600
PREMIUM_GRACIA_DIAS=1
